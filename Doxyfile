PROJECT_NAME           = rbxx
PROJECT_NUMBER         = 0.1.0
OUTPUT_DIRECTORY       = tmp/doxygen
INPUT                  = include/rbxx docs/api.md
FILE_PATTERNS           = *.hpp *.md
RECURSIVE               = YES
EXTRACT_ALL             = NO
EXTRACT_PRIVATE         = NO
EXTRACT_STATIC          = NO
HIDE_UNDOC_MEMBERS      = YES
HIDE_UNDOC_CLASSES      = YES
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_AS_ERROR           = FAIL_ON_WARNINGS
EXCLUDE_SYMBOLS         = rbxx::detail::* rbxx::type_caster*
GENERATE_HTML           = YES
GENERATE_LATEX          = NO
QUIET                   = YES
JAVADOC_AUTOBRIEF       = YES
MARKDOWN_SUPPORT        = YES
USE_MDFILE_AS_MAINPAGE  = docs/api.md
ENABLE_PREPROCESSING    = YES
MACRO_EXPANSION         = YES
PREDEFINED              = module=module_handle
